# Скопируй в .env и подставь свои значения. Файл .env в git не попадает.

# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Для локального запуска без Docker можно использовать SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./todo.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/todo_db
